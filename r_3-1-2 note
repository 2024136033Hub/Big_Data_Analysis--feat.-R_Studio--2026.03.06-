6. subset함수
# 다음과 같은 벡터가 있을 때 세 벡터를 하나로 묶어 데이터프레임 df에 저장한 후 blood 열이름 값이 'B'가 아닌 행들을 추출해 df.nb에 저장하는 코드를 작성하시오

blood <- c('A','O','AB','B','B')
rh <- c('+','+','-','+','+')
age <- c(21,30,43,17,26)

# 정답)
df = data.frame(blood, rh, age)
df.nb = subset(df,blood != 'B')


